# Modo de dados:
# local = demonstração, dados apenas no navegador
# supabase = login + persistência centralizada da empresa
NEXT_PUBLIC_DATA_MODE=local

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=COLE_A_CHAVE_PUBLICA_AQUI

# Usado somente pelo endpoint server-side de pedidos externos.
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_SOMENTE_NA_VERCEL
INTEGRATION_WEBHOOK_SECRET=CRIE_UM_SEGREDO_FORTE

# PIN gerencial usado apenas no servidor para áreas e ações protegidas.
# Configure na Vercel como variável privada (sem NEXT_PUBLIC_).
MANAGER_PIN=4024
